{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "../package.json",
  "identifier": "com.copydiff.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Relay — 跨仓库提交迁移",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3NDUwNDU2Qzk2MEM3QUIKUldTcngyREpWZ1JGVjlkY0t1VFZTNmp5Mjh0TjlrUGJCcDFLSWxucFMyZGNQcXhVT1pRU3pZc08K",
      "endpoints": [
        "https://github.com/ginnsx/commit-replay/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "shell": {
      "open": true,
      "scope": [
        { "name": "git", "cmd": "git", "args": true },
        { "name": "svn", "cmd": "svn", "args": true }
      ]
    }
  }
}
